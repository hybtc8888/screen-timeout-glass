{
  "name": "screen-timeout-glass",
  "version": "1.2.7",
  "private": true,
  "description": "A tiny Liquid Glass desktop switch for Windows screen timeout settings.",
  "author": "hybtc8888",
  "homepage": "https://github.com/hybtc8888/screen-timeout-glass#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hybtc8888/screen-timeout-glass.git"
  },
  "bugs": {
    "url": "https://github.com/hybtc8888/screen-timeout-glass/issues"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "preview": "vite preview",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "dist": "npm run dist:win-x64",
    "dist:win-x64": "npm run build && electron-builder --win portable --x64"
  },
  "dependencies": {
    "liquid-glass-react": "1.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.0.4",
    "concurrently": "9.2.1",
    "cross-env": "10.1.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "vite": "8.1.5",
    "wait-on": "9.0.4"
  },
  "build": {
    "appId": "com.local.screen-timeout-glass",
    "productName": "熄屏快捷框",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/app-icon.png",
      "assets/app-icon.ico",
      "package.json"
    ],
    "win": {
      "icon": "assets/app-icon.ico",
      "artifactName": "熄屏快捷框-${version}-Windows-x64-便携版.${ext}",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
